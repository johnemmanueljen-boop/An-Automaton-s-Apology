# Copy to .env (git-ignored). Only needed to audit new results; browsing and re-running cached results need no key.
ANTHROPIC_API_KEY=sk-ant-...
LLM_BUDGET_USD=5          # hard cap on total spend, checked before every call
# LLM_MODEL_AUDIT=claude-opus-5-5     # the auditor
# LLM_MODEL_PROBE=claude-sonnet-5-5   # writes Lean probes and restatements

# Offline is the default. --online on audit/bundles permits budget-limited API calls.
APOLOGY_OFFLINE=1
# Live Lean is disabled until an execution policy is explicitly configured.
APOLOGY_LEAN_MODE=disabled
# APOLOGY_LEAN_MODE=docker
# APOLOGY_LEAN_IMAGE=your-prebuilt-matching-toolchain-image@sha256:<digest>
# For trusted local fixtures only: APOLOGY_LEAN_MODE=local and APOLOGY_TRUST_LOCAL_LEAN=1
